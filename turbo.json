{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "NODE_ENV",
    "FRONTEND_URL",
    "LOG_LEVEL",
    "OPENAI_API_KEY",
    "RECALL_API_KEY",
    "RECALL_API_URL",
    "RECALL_WEBHOOK_SECRET",
    "RECALL_BOT_NAME",
    "RECALL_REALTIME_WEBHOOK_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PRICE_ID_STUDIO_PRO_MONTHLY",
    "STRIPE_PRICE_ID_STUDIO_PRO_YEARLY",
    "SENTRY_DSN_API",
    "SENTRY_DSN_WORKER",
    "GIT_SHA",
    "WORKER_HEALTH_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^db:generate"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    }
  }
}
