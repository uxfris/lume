# Shared
NODE_ENV=development
DATABASE_URL=postgresql://lume:lume@localhost:5432/lume
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=lume-dev

# Logging
LOG_LEVEL=info

# Phase 3+ (Whisper service)
WHISPER_URL=http://localhost:8000
PYANNOTE_URL=http://localhost:8000

# Phase 5+ (OpenAI: analyze + embed)
OPENAI_API_KEY=

# Phase 8 — Recall.ai (worker downloads bot media)
RECALL_API_KEY=
RECALL_API_URL=https://us-west-2.recall.ai/api/v1

# Phase 12 — Observability + deployment
# Sentry DSN for the worker process (leave blank locally to disable)
SENTRY_DSN_WORKER=
# Commit SHA injected by deploy pipeline (Railway: ${RAILWAY_GIT_COMMIT_SHA})
GIT_SHA=
# Tiny http server for /health + /metrics; default 9100
WORKER_HEALTH_PORT=9100
