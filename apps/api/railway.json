{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/database db:generate && pnpm --filter @workspace/api... build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/database db:deploy && pnpm --filter @workspace/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
