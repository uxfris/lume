# Phase 8 — Recall.ai
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
RECALL_API_URL=https://us-east-1.recall.ai/api/v1
RECALL_BOT_NAME=Lume Notetaker
# Optional: set to enable live transcript.data streaming during the call.
# Must be a public HTTPS URL pointing at /webhooks/recall/realtime.
RECALL_REALTIME_WEBHOOK_URL=

# Phase 11 — Stripe (Studio Pro checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STUDIO_PRO_MONTHLY=
STRIPE_PRICE_ID_STUDIO_PRO_YEARLY=

# Transactional email (Resend) — workspace invites and meeting share
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lume <hello@yourdomain.com>

# Integrations — Slack & Linear OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Phase 12 — Observability + deployment
# Sentry DSN for the api process (leave blank locally to disable)
SENTRY_DSN_API=
# Commit SHA injected by deploy pipeline (Railway: ${RAILWAY_GIT_COMMIT_SHA})
GIT_SHA=
# pino log level: fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info

# Twilio (SMS for phone verification and 2FA OTP)
TWILLIO_ACCOUNT_SID=
TWILLIO_AUTH_TOKEN=
TWILLIO_PHONE_NUMBER=